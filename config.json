{
    "network": {
        "use_testnet": false,
        "endpoints": {
            "gateway_testnet": "https://gateway.test.nado.xyz/v1",
            "gateway_mainnet": "https://gateway.prod.nado.xyz/v1",
            "ws_testnet": "wss://gateway.test.nado.xyz/v1/ws",
            "ws_mainnet": "wss://gateway.prod.nado.xyz/v1/ws"
        },
        "chain_id_testnet": 763373,
        "chain_id_mainnet": 57073
    },

    "wallet": {
        "private_key_env": "PRIVATE_KEY",
        "wallet_address_env": "WALLET_ADDRESS",
        "subaccount_name": "default"
    },

    "trading": {
        "mode": "scalping",
        "whitelist_pairs": ["BTC-PERP", "ETH-PERP", "SOL-PERP", "XRP-PERP"],
        "blacklist": ["MSFT","AMZN","AAPL","TSLA","NVDA","GOOGL","SPY","QQQ","ADA"],
        "loop_interval_seconds": 60,
        "cooldown_after_trade_seconds": 60,
        "max_active_trades": 2
    },

    "strategy": {
        "candle_count": 60,
        "breakout_lookback": 20,
        "volume_spike_multiplier": 1.5,
        "sentiment_weight": true,
        "rsi_oversold": 35.0,
        "rsi_overbought": 65.0,
        "ema_fast": 9,
        "ema_slow": 21,
        "min_entry_score": 3,
        "min_risk_reward": 1.0
    },

    "risk": {
        "risk_per_trade_pct": 0.15,
        "isolated_margin_pct": 0.15,
        "max_leverage": 20,
        "min_notional_usd": 100,
        "scalp_sl_atr_mult": 0.8,
        "scalp_tp1_atr_mult": 0.8,
        "scalp_tp2_atr_mult": 1.5,
        "trailing_sl_pct": 0.008,
        "breakeven_pct": 0.005,
        "early_exit_rsi_long": 70,
        "early_exit_rsi_short": 30,
        "max_open_trades": 2,
        "min_balance_usdt": 0.5
    },

    "news": {
        "rss_feeds": [
            "https://cointelegraph.com/rss",
            "https://www.coindesk.com/arc/outboundfeeds/rss/",
            "https://decrypt.co/feed",
            "https://bitcoinmagazine.com/.rss/full/"
        ],
        "twitter_keywords": ["BTC","ETH","crypto","listing","partnership","bitcoin","ethereum"],
        "scrape_interval_seconds": 300,
        "positive_keywords": [
            "bullish","breakout","listing","partnership","launch",
            "rally","surge","pump","moon","adoption","approved",
            "institutional","upgrade","all-time high","ath","buy",
            "accumulate","etf","green","recover","soar"
        ],
        "negative_keywords": [
            "hack","exploit","dump","bearish","selloff",
            "crash","scam","fraud","liquidation","ban",
            "crackdown","decline","plunge","red","fear",
            "rug","vulnerability","breach","sec","lawsuit"
        ]
    },

    "logging": {
        "log_level": "INFO",
        "log_file": "nado_auto_trader.log",
        "trade_log_file": "trades.log"
    },

    "backtest": {
        "enabled": false,
        "start_date": "2025-01-01",
        "end_date": "2025-12-31",
        "initial_balance": 1000.0
    }
}
